// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Kita biarkan Prisma mengatur lokasi outputnya agar lebih sederhana
  // output = "../generated/prisma" 
}

datasource db {
  provider = "postgresql"

}

// --- ENUMS ---

// Enum untuk Status AKUN (Administratif)
enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

// Enum untuk Status KEHADIRAN (Untuk fitur chat nanti)
enum UserPresence {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

// --- MODELS ---

model User {
  id           BigInt        @id @default(autoincrement())
  username     String        @unique
  email        String        @unique
  passwordHash String
  avatarUrl    String?       
  bio           String?      @db.Text
  status       UserStatus    @default(ACTIVE) 
  presence     UserPresence  @default(OFFLINE) 

  // Relasi
  roles        UserRole[]
  refreshTokens RefreshToken[]

  // Timestamps
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Role {
  id          BigInt @id @default(autoincrement())
  name        String @unique
  description String?

  users UserRole[]

  @@map("roles")
}

// Tabel Penghubung User dan Role (Many-to-Many)
model UserRole {
  id     BigInt @id @default(autoincrement())
  userId BigInt
  roleId BigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// Tabel untuk menyimpan Refresh Token yang aman
model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  token     String   @unique
  userId    BigInt
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}